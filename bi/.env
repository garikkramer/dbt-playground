# Lightdash Environment Variables
LIGHTDASH_SECRET=super_secret_lightdash_key_32_chars_long_minimum
SITE_URL=http://localhost:8080

# Internal Postgres DB Credentials
POSTGRES_USER=lightdash
POSTGRES_PASSWORD=lightdash_password
POSTGRES_DB=lightdash_db

# Local MinIO (S3-compatible) Storage Credentials
S3_ENDPOINT=http://minio:9000
S3_BUCKET=lightdash
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadminpassword
